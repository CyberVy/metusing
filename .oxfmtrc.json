{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "tabWidth": 4,
  "useTabs": false,
  "semi": false,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "bracketSpacing": true,
  "bracketSameLine": false,
  "trailingComma": "none",
  "printWidth": 120,
  "ignorePatterns": [
    "node_modules",
    ".next",
    "out",
    "build",
    "dist",
    "public/sw.js",
    "src-tauri/src/inject.js",
    "draft",
    "cli/dist"
  ]
}
