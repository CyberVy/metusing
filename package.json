{
    "name": "metusing",
    "version": "0.1.0",
    "private": true,
    "description": "Karaoke and Pitch Tracking App",
    "type": "module",
    "scripts": {
        "tauri": "cargo tauri",
        "debug:eval": "tsx cli/debug/host/eval.ts",
        "debug:ui": "tsx cli/debug/host/ui.ts",
        "debug:lazy-container": "tsx cli/debug/checks/lazy_container_dimensions.ts",
        "dev": "npm run dev:frontend",
        "dev:frontend": "vite",
        "build": "npm run build:frontend",
        "build:frontend": "vite build",
        "lint": "oxlint frontend cli --deny-warnings",
        "format": "oxfmt frontend cli",
        "format:check": "oxfmt --check frontend cli",
        "typecheck": "tsc --noEmit && tsc -p frontend/tsconfig.json --noEmit",
        "check": "concurrently \"oxlint frontend cli --deny-warnings\" \"npm run typecheck\"",
        "dev:injection": "esbuild src-tauri/src/inject.ts --bundle --format=esm --target=esnext --tsconfig=frontend/tsconfig.json --outfile=src-tauri/src/inject.js --watch=forever --banner:js=\"// Generated by src-tauri/src/inject.ts\"",
        "build:injection": "esbuild src-tauri/src/inject.ts --bundle --format=esm --target=esnext --tsconfig=frontend/tsconfig.json --outfile=src-tauri/src/inject.js --minify --banner:js=\"// Generated by src-tauri/src/inject.ts\""
    },
    "dependencies": {
        "localforage": "^1.10.0",
        "lucide-react": "^1.77.0",
        "react": "19.2.1",
        "react-dom": "19.2.1"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/node": "^24",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^6.1.1",
        "babel-plugin-react-compiler": "^1.0.0",
        "concurrently": "^10.0.3",
        "esbuild": "^0.27.0",
        "oxc-transform-react": "^0.145.0",
        "oxfmt": "^0.73.0",
        "oxlint": "^1.81.0",
        "tailwindcss": "^4",
        "tsx": "^4.23.0",
        "typescript": "^7.0.2",
        "vite": "^8.2.2"
    },
    "title": "Metusing"
}
